generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentBlockType {
  HEADING
  SUBHEADING
  PARAGRAPH
  IMAGE
  IMAGE_TEXT
  GALLERY
  QUOTE
  VIDEO
  LOCATION
  JOURNEY_INFO
  ENCOUNTER
  DIVIDER
}

enum ImageDisplay {
  AUTO
  STANDARD
  WIDE
  FULLSCREEN
  SPLIT
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageStatus {
  UNREAD
  READ
}

enum FeatureMode {
  AUTOMATIC
  MANUAL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journeys          Journey[]
  blogs             Blog[]
  quotes            Quote[]
  versions          ContentVersion[]
  moderatedComments Comment[]        @relation("CommentModerator")
}

model Journey {
  id         String  @id @default(cuid())
  title      String
  slug       String  @unique
  location   String
  country    String
  coverImage String?
  shortIntro String?

  journeyDate   DateTime?
  duration      String?
  distance      String?
  difficulty    String?
  companions    String?
  placesVisited String?

  status     ContentStatus @default(DRAFT)
  isFeatured Boolean       @default(false)

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  noIndex        Boolean @default(false)
  noFollow       Boolean @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  contentBlocks ContentBlock[]
  media         MediaAsset[]
  encounters    Encounter[]
  versions      ContentVersion[]
  comments      Comment[]
  blogs         Blog[]           @relation("JourneyBlog")
  quotes        Quote[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([status])
  @@index([authorId])
  @@index([location])
  @@index([country])
}

model Blog {
  id         String  @id @default(cuid())
  title      String
  slug       String  @unique
  subtitle   String?
  coverImage String?
  shortIntro String?

  status     ContentStatus @default(DRAFT)
  isFeatured Boolean       @default(false)

  relatedJourneyId String?
  relatedJourney   Journey? @relation("JourneyBlog", fields: [relatedJourneyId], references: [id], onDelete: SetNull)

  location String?

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  noIndex        Boolean @default(false)
  noFollow       Boolean @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  contentBlocks ContentBlock[]
  versions      ContentVersion[]
  comments      Comment[]
  quotes        Quote[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([status])
  @@index([authorId])
  @@index([relatedJourneyId])
  @@index([location])
}

model ContentBlock {
  id           String           @id @default(cuid())
  type         ContentBlockType
  position     Int
  data         Json
  imageDisplay ImageDisplay?

  journeyId String?
  journey   Journey? @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  blogId String?
  blog   Blog?   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  mediaId String?
  media   MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId, position])
  @@index([blogId, position])
}

model MediaAsset {
  id           String  @id @default(cuid())
  url          String
  thumbnailUrl String?
  fileName     String
  mimeType     String
  width        Int?
  height       Int?
  fileSize     Int?

  caption String?
  altText String?

  location     String?
  capturedDate DateTime?
  photographer String    @default("Aditya Valvi")

  journeyId String?
  journey   Journey? @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  blocks    ContentBlock[]
  encounter Encounter?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId])
}

model Encounter {
  id         String  @id @default(cuid())
  title      String
  shortIntro String?
  story      Json

  featuredOnHomepage Boolean @default(false)

  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  mediaId String?     @unique
  media   MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId])
  @@index([featuredOnHomepage])
}

model DreamDestination {
  id         String  @id @default(cuid())
  name       String
  country    String
  coverImage String?
  shortNote  String?
  whyVisit   String?
  interests  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
}

model Quote {
  id     String  @id @default(cuid())
  text   String
  author String?
  source String?

  journeyId String?
  journey   Journey? @relation(fields: [journeyId], references: [id], onDelete: SetNull)

  blogId String?
  blog   Blog?   @relation(fields: [blogId], references: [id], onDelete: SetNull)

  position Int     @default(0)
  isActive Boolean @default(true)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([journeyId])
  @@index([blogId])
}

model Comment {
  id      String        @id @default(cuid())
  name    String
  email   String
  content String
  status  CommentStatus @default(PENDING)

  journeyId String?
  journey   Journey? @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  blogId String?
  blog   Blog?   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  moderatedById String?
  moderatedBy   User?   @relation("CommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  moderatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([journeyId])
  @@index([blogId])
}

model ContactMessage {
  id      String        @id @default(cuid())
  name    String
  email   String
  message String
  status  MessageStatus @default(UNREAD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ContentVersion {
  id            String @id @default(cuid())
  versionNumber Int
  snapshot      Json

  journeyId String?
  journey   Journey? @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  blogId String?
  blog   Blog?   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@unique([journeyId, versionNumber])
  @@unique([blogId, versionNumber])
  @@index([journeyId])
  @@index([blogId])
}

model AboutPage {
  id String @id @default(cuid())

  content Json

  seoTitle       String?
  seoDescription String?
  ogImage        String?

  updatedAt DateTime @updatedAt
}

model ContactSettings {
  id String @id @default(cuid())

  introMessage String?
  email        String?
  closingText  String?

  updatedAt DateTime @updatedAt
}

model SocialLink {
  id       String  @id @default(cuid())
  platform String
  label    String
  url      String
  icon     String?
  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([isActive])
}

model SiteSettings {
  id String @id @default(cuid())

  siteName     String @default("Nomads of Aditya")
  ownerName    String @default("Aditya Valvi")
  defaultTheme String @default("dark")
  accentColor  String @default("#D99A3D")

  heroHeadline    String?
  heroSubheadline String?

  journeyFeatureMode FeatureMode @default(AUTOMATIC)
  featuredJourneyId  String?

  blogFeatureMode FeatureMode @default(AUTOMATIC)
  featuredBlogId  String?

  updatedAt DateTime @updatedAt
}
